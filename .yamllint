---
extends: default
ignore:
  - .forgejo
  - .pre-commit-config.yaml
  - .venv
  - .ansible
rules:
  line-length:
    max: 240
    level: warning
  comments:
    min-spaces-from-content: 1
  # Both settings are mandated by ansible-lint; diverging makes it drop fix mode.
  comments-indentation: false
  braces:
    max-spaces-inside: 1
    max-spaces-inside-empty: 0
  brackets:
    max-spaces-inside: 1
    max-spaces-inside-empty: 0
  octal-values:
    forbid-explicit-octal: true
    forbid-implicit-octal: true
  document-start:
    level: error
  key-duplicates:
    forbid-duplicated-merge-keys: true
    level: error
