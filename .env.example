# Copy to .env and fill in. .env is gitignored and must stay that way: it holds a live
# credential.
#
#   cp .env.example .env && direnv allow

# --- Required by the hack/ scripts that talk to the endpoint -------------------------------
# The proxy's bearer token, the same value stored in Vault at ollama-proxy/token.
OLLAMA_TOKEN=

# --- Endpoint --------------------------------------------------------------------------------
# Defaults to the address below, so only set this to reach the machine another way.
#OLLAMA_URL=https://ollama.otter.derwitt.site:11434

# --- Reading the GPU from elsewhere ----------------------------------------------------------
# rocm-smi has to run on the machine. Set this to drive the benchmarks from another host;
# leave unset when running on the machine itself.
#SSH_HOST=otter
# Only needed if rocm-smi is neither on PATH nor at /opt/rocm/bin/rocm-smi.
#ROCM_SMI=/opt/rocm/bin/rocm-smi
# The discrete card's PCI device id, used to tell it apart from the iGPU.
#XTX_DID=0x744c

# --- Benchmark tuning ------------------------------------------------------------------------
#RUNS=3
#NUM_PREDICT=512
#PROMPT=Write a Go function that merges two sorted integer slices into one sorted slice.
#CTX_LIST=4096 8192 16384 32768 65536 131072

# --- Ansible ---------------------------------------------------------------------------------
# group_vars holds ansible-vault encrypted values, so the playbooks need the password.
#ANSIBLE_VAULT_PASSWORD_FILE=~/.config/ansible/vault-pass
