# shellcheck shell=bash

# Secrets and machine-specific values live in .env, which is gitignored. Start from
# .env.example. Absent, everything still works from the defaults baked into the scripts,
# except the ones needing a token.
dotenv_if_exists .env

# The repo's own venv, created by hack/setup-venv.sh. Entering the directory is a better
# moment to pick it up than remembering to activate it.
if [ -f .venv/bin/activate ]; then
	# shellcheck disable=SC1091
	source .venv/bin/activate
fi
